<Window x:Class="SeniorWhatsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senior WhatsApp" WindowState="Maximized" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI" SizeChanged="OnSizeChanged" StateChanged="OnStateChanged"
        PreviewMouseMove="OnUserInput" PreviewKeyDown="OnUserInput" PreviewMouseDown="OnUserInput">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#16385B" Offset="0"/>
            <GradientStop Color="#2C6A9E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kontakty: duże prostokątne kafelki po lewej -->
        <ListBox x:Name="ContactList" Grid.Column="0" Margin="24,24,8,10"
                 ItemsSource="{Binding Contacts}"
                 ItemTemplate="{StaticResource ContactTile}"
                 ItemContainerStyle="{StaticResource TileItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnContactSelected"/>

        <Grid x:Name="RightPane" Grid.Column="1" SizeChanged="OnRightPaneSizeChanged">
            <!-- Wyłączenie programu: biały X na czerwonym tle, 128 x 128 -->
            <Button x:Name="ExitButton" Style="{StaticResource SquareButton}" Click="OnExit" AutomationProperties.Name="Wyłącz program"
                    Width="128" Height="128" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,28,0"
                    Background="#D62828" ToolTip="Wyłącz program" Focusable="False">
                <Path Data="M 0,0 L 24,24 M 24,0 L 0,24" Stroke="White" StrokeThickness="14" Stretch="Fill" Width="64" Height="64"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>

            <!-- Wybrany kontakt: duży obraz z podpisem, pod spodem przycisk rozmowy wideo -->
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="30,40,30,20">
                <Border x:Name="BigAvatar" Width="340" Height="340" CornerRadius="40" Background="#4C7FB0"
                        BorderBrush="White" BorderThickness="8" HorizontalAlignment="Center">
                    <Grid>
                        <Border CornerRadius="32">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Image}" Viewbox="{Binding Crop}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="BigInitial" Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="160"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="BigName" Text="{Binding Name}" Foreground="White" FontWeight="Bold"
                           FontSize="{Binding DataContext.NameFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=1.5}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1000" Margin="0,22,0,26"/>
                <Button x:Name="CallButton" Style="{StaticResource BigButton}" Click="OnCall" AutomationProperties.Name="Zadzwoń wideo"
                        Background="#2EA043" Width="520" Height="190" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VideoIcon" FontFamily="{StaticResource IconFont}" Text="&#xE714;" FontSize="110" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PhoneIcon" FontFamily="{StaticResource IconFont}" Text="&#xE717;" FontSize="96" Foreground="White" VerticalAlignment="Center" Margin="36,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CallHint" Text="Naciśnij zielony przycisk, aby zadzwonić" Foreground="#E6F0FA" FontSize="28"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"/>
                <TextBlock x:Name="NoticeText" Foreground="#FFD27A" FontSize="28" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Brak kamery: duża informacja i możliwość zwykłej rozmowy głosowej -->
            <Border x:Name="NoCameraPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F2102A43" BorderBrush="#FFC857" BorderThickness="6" CornerRadius="36" Padding="56,44">
                <StackPanel Width="1000">
                    <TextBlock Text="Nie wykryto kamery" Foreground="#FFC857" FontSize="72" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Do komputera nie jest podłączona kamera, więc nie można zadzwonić z obrazem."
                               Foreground="White" FontSize="38" TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0"/>
                    <TextBlock Text="Możesz zadzwonić zwykłą rozmową – tylko z dźwiękiem, bez obrazu."
                               Foreground="White" FontSize="38" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,32"/>
                    <Button x:Name="VoiceCallButton" Style="{StaticResource BigButton}" Click="OnVoiceCall" AutomationProperties.Name="Zadzwoń bez kamery"
                            Background="#2EA043" Height="150" Margin="0,0,0,22">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE717;" FontSize="84" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Zadzwoń bez kamery" FontSize="52" FontWeight="Bold" Foreground="White" Margin="30,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BackButton" Style="{StaticResource BigButton}" Click="OnNoCameraBack"
                            Background="#5C6F82" Height="110">
                        <TextBlock Text="Wróć" FontSize="46" FontWeight="Bold" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Podpowiedź, gdy nic nie wybrano -->
            <TextBlock x:Name="EmptyHint" Foreground="White" FontSize="44" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>

            <!-- Na dole po prawej: ustawienia (trzeba przytrzymać przez sekundę); podpowiedź pojawia się z lewej strony przycisku -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,22">
                <TextBlock x:Name="HoldHint" Foreground="#FFD27A" FontSize="12" FontWeight="SemiBold"
                           TextAlignment="Right" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="Collapsed" IsHitTestVisible="False"
                           Text="Aby otworzyć ustawienia, przytrzymaj ten przycisk przez 1 sekundę."/>
                <Button x:Name="SettingsButton" Style="{StaticResource BigButton}" Focusable="False" AutomationProperties.Name="Ustawienia (przytrzymaj)"
                        VerticalAlignment="Center" Background="#33FFFFFF" Padding="22,10"
                        PreviewMouseLeftButtonDown="Settings_Down" PreviewMouseLeftButtonUp="Settings_Up" MouseLeave="Settings_Up">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="34" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Ustawienia" FontSize="26" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="HoldBar" Height="6" CornerRadius="3" Background="#FFC857"
                                VerticalAlignment="Bottom" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoldScale" ScaleX="0" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
