<Window x:Class="SeniorWhatsApp.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import z WhatsApp" Width="820" Height="760" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="20" Background="#F1F5F9">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Import z WhatsApp" FontSize="28" FontWeight="Bold" Foreground="#16385B"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Program odczytuje nazwy rozmów z listy czatów w WhatsApp. Numerów telefonów i zdjęć WhatsApp nie udostępnia – zdjęcia dodasz w ustawieniach. Rozmowy będą otwierane po nazwie."/>
            <TextBlock x:Name="StatusText" Margin="0,12,0,12" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox x:Name="ItemsList" Grid.Row="1" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" Margin="4,6" Content="{Binding Name}" FontSize="22"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <Button Content="Zaznacz wszystko" Padding="16,10" Margin="0,0,10,0" Click="OnSelectAll" DockPanel.Dock="Left"/>
            <Button Content="Odznacz wszystko" Padding="16,10" Click="OnSelectNone" DockPanel.Dock="Left"/>
            <Button x:Name="ImportButton" Content="Importuj zaznaczone" Padding="26,12" FontWeight="Bold" Background="#2EA043" Foreground="White"
                    Click="OnImport" DockPanel.Dock="Right" IsEnabled="False"/>
            <Button Content="Anuluj" Padding="22,12" Margin="0,0,12,0" Click="OnCancel" DockPanel.Dock="Right" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
