<Window x:Class="SeniorWhatsApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia" Width="1320" Height="920" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="20" Background="#F1F5F9">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#16385B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista osób -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Osoby" Style="{StaticResource SectionTitle}"/>
                <ListBox x:Name="List" Grid.Row="1" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnContactChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <Border Width="56" Height="56" CornerRadius="10" Background="#4C7FB0">
                                    <Grid>
                                        <Border CornerRadius="10">
                                            <Border.Background><ImageBrush ImageSource="{Binding Image}" Viewbox="{Binding Crop}" Stretch="UniformToFill"/></Border.Background>
                                        </Border>
                                        <TextBlock x:Name="Init" Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="22" VerticalAlignment="Center" Margin="14,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                    <Setter TargetName="Init" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                    <Button Content="+ Dodaj osobę" Style="{StaticResource ActionButton}" Click="OnAdd"/>
                    <Button Content="Usuń" Style="{StaticResource ActionButton}" Click="OnDelete"/>
                    <Button Content="▲ Wyżej" Style="{StaticResource ActionButton}" Click="OnMoveUp"/>
                    <Button Content="▼ Niżej" Style="{StaticResource ActionButton}" Click="OnMoveDown"/>
                    <Button Content="Importuj z WhatsApp…" Style="{StaticResource ActionButton}" Click="OnImport"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Prawa strona -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Dane osoby -->
                <Border x:Name="EditCard" Style="{StaticResource Card}">
                    <Grid DataContext="{Binding SelectedItem, ElementName=List}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dane wybranej osoby" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Nazwa wyświetlana (może być inna niż w WhatsApp, np. „Babcia Ania”)" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Numer telefonu w WhatsApp (np. +48 600 100 200)" TextWrapping="Wrap" Margin="0,14,0,4"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Nazwa czatu w WhatsApp (uzupełnia się sama; potrzebna tylko, gdy nie ma numeru)" TextWrapping="Wrap" Margin="0,14,0,4"/>
                            <TextBox Text="{Binding WaName, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="VerifyButton" Content="Sprawdź w WhatsApp" Style="{StaticResource ActionButton}" Click="OnVerifyChat" Margin="0,0,12,0"/>
                                <TextBlock x:Name="VerifyStatus" VerticalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" MaxWidth="330"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" Width="300">
                            <TextBlock Text="Zdjęcie – ustaw twarz w ramce" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border x:Name="PhotoFrame" Width="260" Height="260" CornerRadius="18" Background="#4C7FB0"
                                    BorderBrush="#C5D3E0" BorderThickness="2" Cursor="SizeAll" HorizontalAlignment="Left"
                                    MouseLeftButtonDown="OnPhotoDown" MouseMove="OnPhotoMove" MouseLeftButtonUp="OnPhotoUp"
                                    MouseWheel="OnPhotoWheel" ToolTip="Przeciągnij myszą, aby przesunąć. Kółko myszy – powiększa.">
                                <Grid>
                                    <Border CornerRadius="16" IsHitTestVisible="False">
                                        <Border.Background><ImageBrush ImageSource="{Binding Image}" Viewbox="{Binding Crop}" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                    <TextBlock x:Name="PhotoInitial" Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="110"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Rozmiar zdjęcia w ramce (mniejszy ◂ ▸ większy)" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <Slider x:Name="ZoomSlider" Minimum="-2" Maximum="2.585" SmallChange="0.05" LargeChange="0.5"
                                    Value="{Binding ZoomSlider}" Margin="0,4,0,4"/>
                            <TextBlock Text="Przeciągnij zdjęcie myszą, aby wycentrować twarz. Kółko myszy też zmienia rozmiar." TextWrapping="Wrap" FontSize="16" Foreground="#555" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="↺ Obróć w lewo" Style="{StaticResource ActionButton}" Click="OnRotateLeft"/>
                                <Button Content="↻ Obróć w prawo" Style="{StaticResource ActionButton}" Click="OnRotateRight"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Wybierz zdjęcie…" Style="{StaticResource ActionButton}" Click="OnPickImage"/>
                                <Button Content="Wyśrodkuj" Style="{StaticResource ActionButton}" Click="OnResetCrop"/>
                                <Button Content="Usuń zdjęcie" Style="{StaticResource ActionButton}" Click="OnRemoveImage"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Wygląd -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Wygląd kafelków" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Szerokość kafelka" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="260" Maximum="1000" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding TileWidth}" Margin="0,8"/>
                            <TextBlock Grid.Column="2" Text="{Binding TileWidth, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Wysokość kafelka" VerticalAlignment="Center"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="80" Maximum="320" SmallChange="5" LargeChange="20" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding TileHeight}" Margin="0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TileHeight, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Wielkość czcionki nazw" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="14" Maximum="90" SmallChange="1" LargeChange="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding NameFontSize}" Margin="0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NameFontSize, StringFormat={}{0:0}}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Podgląd:" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="Preview" ContentTemplate="{StaticResource ContactTile}" HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Aktualizacje -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Aktualizacje programu" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="VersionText" Margin="0,0,0,8"/>
                        <CheckBox IsChecked="{Binding AutoUpdate}" Margin="0,0,0,12">
                            <TextBlock Text="Sprawdzaj i pobieraj aktualizacje automatycznie (z GitHuba)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <WrapPanel>
                            <Button x:Name="CheckUpdateButton" Content="Sprawdź teraz" Style="{StaticResource ActionButton}" Click="OnCheckUpdate"/>
                            <Button x:Name="InstallUpdateButton" Content="Zainstaluj i uruchom ponownie" Style="{StaticResource ActionButton}"
                                    Click="OnInstallUpdate" Visibility="Collapsed"/>
                        </WrapPanel>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Dane -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gdzie są zapisane ustawienia" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DataPath" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Otwórz ten folder" Style="{StaticResource ActionButton}" Click="OnOpenDataFolder" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Dół -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0">
            <Button Content="Zamknij program" HorizontalAlignment="Left" Padding="22,12" FontSize="22" Click="OnQuit"/>
            <Button Content="Gotowe" HorizontalAlignment="Right" Padding="60,12" FontSize="26" FontWeight="Bold"
                    Background="#2EA043" Foreground="White" IsDefault="True" Click="OnDone"/>
        </Grid>
    </Grid>
</Window>
